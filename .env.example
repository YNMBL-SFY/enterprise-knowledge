# 复制本文件为 .env 并填写你的密钥
# 智谱开放平台 API Key：https://open.bigmodel.cn/
ZHIPU_API_KEY=your-api-key-here

# 模型配置（对话模型使用有专项资源包的 glm-4.5-air；embedding-3 与 rerank 均有额度）
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=512
RERANK_MODEL=rerank
CHAT_MODEL=glm-4.5-air

# Milvus 连接（本地 Docker Compose 默认值；使用 Zilliz Cloud 时填写托管地址与 Token）
MILVUS_ADDRESS=127.0.0.1:19530
MILVUS_COLLECTION=enterprise_knowledge_chunks
# MILVUS_TOKEN=
# --- Zilliz Cloud 托管示例（中国区 Serverless）---
# MILVUS_ADDRESS=https://in03-xxxx.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn/v2/vectordb/collections/list
# MILVUS_TOKEN=<控制台 API Key，格式裸 key 即可>

# 存储与端口
# STORAGE_ROOT=
PORT=1111
